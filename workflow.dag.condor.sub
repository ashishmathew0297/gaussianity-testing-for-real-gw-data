# Filename: workflow.dag.condor.sub
# Generated by condor_submit_dag workflow.dag 
universe    = scheduler
executable  = /bin/condor_dagman
getenv      = CONDOR_CONFIG,_CONDOR_*,PATH,PYTHONPATH,PERL*,PEGASUS_*,TZ,HOME,USER,LANG,LC_ALL,ASAN_OPTIONS,LSAN_OPTIONS,BEARER_TOKEN,BEARER_TOKEN_FILE
output      = workflow.dag.lib.out
error       = workflow.dag.lib.err
log         = workflow.dag.dagman.log
remove_kill_sig = SIGUSR1
My.OtherJobRemoveRequirements = "DAGManJobId =?= $(cluster)"
My.IsDaemonCore = True
# Note: default on_exit_remove expression:
# (ExitSignal =?= 11 || (ExitCode =!= UNDEFINED && ExitCode >=0 && ExitCode <= 2))
# attempts to ensure that DAGMan is automatically
# requeued by the schedd if it exits abnormally or
# is killed (e.g., during a reboot).
on_exit_remove = (ExitSignal =?= 11 || (ExitCode =!= UNDEFINED && ExitCode >=0 && ExitCode <= 2))
arguments = "-f -l . -Lockfile workflow.dag.lock -Dag workflow.dag -CsdVersion $CondorVersion:' '25.12.2' '2026-07-20' 'BuildID:' '933077' 'PackageID:' '25.12.2-1' '$ -dagman /bin/condor_dagman -AutoRescue 1"
environment = "_CONDOR_DAGMAN_LOG=workflow.dag.dagman.out _CONDOR_MAX_DAGMAN_LOG=0 _CONDOR_SCHEDD_ADDRESS_FILE=/var/log/condor/.schedd_address _CONDOR_SCHEDD_DAEMON_AD_FILE=/var/log/condor/.schedd_classad"
queue
